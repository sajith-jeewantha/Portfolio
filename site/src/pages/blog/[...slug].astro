---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Ornament from '../../components/Ornament.astro';
import TocSpy from '../../components/TocSpy.astro';
import { formatDate, getPosts, profile, readingTime, site } from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt } = post.data;
const toc = headings.filter((h) => h.depth === 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: profile.name, url: site.url },
  url: new URL(`/blog/${post.id}/`, site.url).href,
};
---

<BaseLayout title={title} description={description} type="article" image={cover} publishedTime={pubDate} jsonLd={jsonLd}>
  <article class="container-x pt-12">
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-lapis">
      <Icon name="arrow-left" /> All posts
    </a>

    <header class="mx-auto mt-8 max-w-3xl text-center">
      <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {updatedDate && (<><span aria-hidden="true">·</span><span>Updated {formatDate(updatedDate)}</span></>)}
      </p>
      <h1 class="mt-4 font-display text-4xl leading-[1.05] font-semibold tracking-tight sm:text-6xl">{title}</h1>
      <p class="mt-5 text-lg text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap justify-center gap-2" aria-label="Tags">
            {tags.map((t) => (
              <li class="chip font-mono text-gold">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <Image src={cover} alt={coverAlt ?? ''} width={1200} loading="eager" class="pane mx-auto mt-10 aspect-[2/1] w-full max-w-4xl object-cover" />
      )
    }

    <Ornament class="mx-auto mt-12 max-w-3xl" />

    <div class="mx-auto mt-10 grid max-w-5xl gap-10 lg:grid-cols-[1fr_13rem]">
      <div class="prose prose-lg prose-cathedral max-w-none min-w-0 prose-headings:scroll-mt-24 prose-a:decoration-gold/50 prose-a:underline-offset-4 prose-img:rounded-xl">
        <Content />
      </div>
      {
        toc.length > 1 && (
          <nav aria-label="On this page" class="hidden lg:block" data-toc-nav>
            <div class="sticky top-24">
              <p class="eyebrow mb-3">On this page</p>
              <ul class="grid gap-2 border-l border-line text-sm">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="toc-link -ml-px block border-l-2 border-transparent pl-4 text-muted hover:border-gold hover:text-ink">
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }
    </div>

    <nav aria-label="More posts" class="mx-auto mt-16 grid max-w-3xl gap-4 border-t border-line pt-8 sm:grid-cols-2">
      {
        older ? (
          <a href={`/blog/${older.id}/`} class="pane pane-hover p-5">
            <span class="text-xs text-muted">← Older</span>
            <span class="mt-1 block font-medium text-ink">{older.data.title}</span>
          </a>
        ) : <span />
      }
      {
        newer && (
          <a href={`/blog/${newer.id}/`} class="pane pane-hover p-5 text-right">
            <span class="text-xs text-muted">Newer →</span>
            <span class="mt-1 block font-medium text-ink">{newer.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
  <TocSpy />
</BaseLayout>
