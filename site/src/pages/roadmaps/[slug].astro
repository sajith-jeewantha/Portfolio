---
import 'katex/dist/katex.min.css';
import '../../styles/roadmaps.css';
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import StageCard from '../../components/roadmaps/StageCard.astro';
import References from '../../components/roadmaps/References.astro';
import RoadmapScripts from '../../components/roadmaps/RoadmapScripts.astro';
import TocSpy from '../../components/TocSpy.astro';
import { formatDate, profile, site } from '../../lib/content';
import {
  WEEKLY_HOUR_OPTIONS,
  DEFAULT_WEEKLY_HOURS,
  accentVar,
  getRoadmaps,
  inline,
  tierLabel,
  totalHours,
  weeks,
} from '../../lib/roadmaps';

export const getStaticPaths = (async () => {
  const all = await getRoadmaps();
  return all.map((roadmap, i) => ({
    params: { slug: roadmap.id },
    props: { roadmap, prev: all[i - 1], next: all[i + 1], all },
  }));
}) satisfies GetStaticPaths;

const { roadmap, prev, next, all } = Astro.props;
const { Content, headings } = await render(roadmap);
const d = roadmap.data;
const id = roadmap.id;
const byId = new Map(all.map((r) => [r.id, r]));
const hours = totalHours(roadmap);
const guide = headings.filter((h) => h.depth === 2);

const toc: { href: string; text: string; sub?: boolean }[] = [
  { href: '#overview', text: 'Overview & why 2027' },
  { href: '#path', text: 'Learning path' },
  { href: '#stages', text: 'Stages' },
  ...(guide.length ? [{ href: '#field-guide', text: 'Field guide' }] : []),
  ...guide.map((h) => ({ href: `#${h.slug}`, text: h.text, sub: true })),
  { href: '#connections', text: 'Connections' },
  { href: '#references', text: 'References' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: `${d.title} roadmap`,
  description: d.summary,
  dateModified: d.updated.toISOString(),
  educationalLevel: 'Beginner to Expert',
  timeRequired: `PT${hours}H`,
  author: { '@type': 'Person', name: profile.name, url: site.url },
  url: new URL(`/roadmaps/${id}/`, site.url).href,
};
---

<BaseLayout
  title={`${d.title} roadmap`}
  description={d.summary}
  type="article"
  ogImage={`/og/roadmaps/${id}.png`}
  ogImageAlt={`${d.title} roadmap — four stages from Beginner to Expert`}
  jsonLd={jsonLd}
  defaultTheme="dark"
  section="roadmaps"
>
  <div class="read-progress" style={`--accent: ${accentVar(id)}`} aria-hidden="true"></div>

  <article class="track container-x pt-10" style={`--accent: ${accentVar(id)}`} data-track={id}>
    <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-muted">
      <a href="/roadmaps/" class="inline-flex items-center gap-1.5 font-medium hover:text-ink"><Icon name="arrow-left" /> All roadmaps</a>
    </nav>

    <!-- Header ---------------------------------------------------------------->
    <header class="mt-8 max-w-3xl">
      <p class="font-mono text-xs tracking-[0.18em] uppercase accent-text">
        Track {String(d.order).padStart(2, '0')} · {tierLabel[d.tier]}
      </p>
      <h1 class="mt-3 flex items-center gap-4 text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
        <span class="grid size-12 flex-none place-items-center rounded-2xl sm:size-14" style="background: var(--accent-soft); color: var(--accent)">
          <Icon name={d.icon} size="28" />
        </span>
        {d.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-text">{d.summary}</p>

      <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div>
          <dt class="text-muted">Last updated</dt>
          <dd class="font-medium text-ink"><time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></dd>
        </div>
        <div>
          <dt class="text-muted">Total effort</dt>
          <dd class="font-medium text-ink">{hours} h · <span data-hours={hours}>≈ {weeks(hours)} weeks</span></dd>
        </div>
        <div>
          <dt class="text-muted"><label for="hours-top">My study time</label></dt>
          <dd>
            <select id="hours-top" data-hours-select class="rounded-lg border border-line bg-elev px-2 py-0.5 font-medium text-ink">
              {WEEKLY_HOUR_OPTIONS.map((h) => <option value={h} selected={h === DEFAULT_WEEKLY_HOURS}>{h} h / week</option>)}
            </select>
          </dd>
        </div>
      </dl>

      <div class="mt-6 flex items-center gap-3" data-meter-wrap>
        <span class="text-sm text-muted">Your progress</span>
        <span class="meter max-w-xs flex-1" data-track-meter role="progressbar" aria-label="Track progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></span>
        <span class="font-mono text-xs text-muted" data-meter-label></span>
        <button type="button" data-reset class="cursor-pointer text-xs text-muted underline-offset-4 hover:text-ink hover:underline">Reset</button>
      </div>
    </header>

    <!-- Overview and the learning-path diagram use the full width; the TOC column starts at Stages -->
    <div class="mt-12">
        <!-- Overview ---------------------------------------------------------->
        <section id="overview" class="scroll-mt-24" data-reveal>
          <h2 class="text-2xl font-semibold">Overview</h2>
          <div class="prose-roadmap prose mt-4 max-w-[70ch] text-[1.03rem]">
            <p set:html={inline(d.overview)} />
            <h3>Why it matters heading into 2027</h3>
            <p set:html={inline(d.why2027)} />
          </div>
          {
            d.demand.length > 0 && (
              <ul class="mt-6 grid max-w-[70ch] gap-3">
                {d.demand.map((s) => (
                  <li class="rounded-xl border-l-2 bg-surface px-4 py-3 text-sm leading-relaxed" style="border-color: var(--accent)">
                    <span class="text-text" set:html={inline(s.claim)} />{' '}
                    <a href={s.url} rel="noopener" class="font-medium whitespace-nowrap text-muted underline-offset-4 hover:text-ink hover:underline">
                      — {s.source} <Icon name="arrow-up-right" size="12" />
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
          {
            d.prerequisites.length > 0 && (
              <div class="mt-8 max-w-[70ch]">
                <h3 class="text-lg font-semibold">Prerequisites</h3>
                <ul class="mt-3 grid gap-2 text-[0.97rem] leading-relaxed">
                  {d.prerequisites.map((p) => (
                    <li class="flex gap-2.5">
                      <Icon name="check" class="mt-1.5 accent-text" />
                      <span set:html={inline(p)} />
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </section>

        <!-- Learning path ------------------------------------------------------>
        <section id="path" class="mt-16 scroll-mt-24" data-reveal>
          <h2 class="text-2xl font-semibold">Learning path</h2>
          <p class="mt-2 max-w-[70ch] text-muted">How the stages build on each other, and where this track hands off to others.</p>
          <figure class="mermaid-figure" data-src={d.diagram} aria-label={`Learning path diagram for ${d.title}`}>
            <div class="mermaid-out"></div>
            <pre class="mermaid-src">{d.diagram}</pre>
          </figure>
        </section>

    </div>

    <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <div class="min-w-0">
        <!-- Stages ------------------------------------------------------------->
        <section id="stages" class="scroll-mt-24">
          <h2 class="text-2xl font-semibold">Stages</h2>
          <p class="mt-2 max-w-[70ch] text-muted">
            Tick items as you go — progress is saved in this browser only. Times are focused hours (reading + building); the week estimates follow the study time you pick above.
          </p>
          <div class="mt-6 grid gap-4">
            {d.stages.map((stage, i) => <StageCard track={id} stage={stage} index={i} open={i === 0} />)}
          </div>
        </section>

        <!-- Field guide (Markdown body) -------------------------------------->
        {
          guide.length > 0 && (
            <section id="field-guide" class="mt-16 scroll-mt-24">
              <h2 class="text-2xl font-semibold">Field guide</h2>
              <p class="mt-2 max-w-[70ch] text-muted">The ideas behind the checklist, with diagrams and the math where it helps.</p>
              <div class="prose-roadmap prose mt-6 max-w-[72ch] text-[1.03rem] prose-headings:scroll-mt-24 prose-h2:mt-12 prose-h2:text-xl prose-h2:font-semibold">
                <Content />
              </div>
            </section>
          )
        }

        <!-- Connections -------------------------------------------------------->
        <section id="connections" class="mt-16 scroll-mt-24" data-reveal>
          <h2 class="text-2xl font-semibold">How this track connects</h2>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {
              d.connections.map((c) => {
                const other = byId.get(c.track);
                return (
                  <li>
                    <a
                      href={`/roadmaps/${c.track}/`}
                      class="track pane pane-hover block h-full p-4"
                      style={`--accent: ${accentVar(c.track)}`}
                    >
                      <span class="flex items-center gap-2 text-sm font-semibold accent-text">
                        {other && <Icon name={other.data.icon} />}
                        {other?.data.short ?? c.track}
                        <Icon name="arrow-right" size="14" />
                      </span>
                      <span class="mt-1.5 block text-sm leading-relaxed text-text" set:html={inline(c.text)} />
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>

        <!-- References --------------------------------------------------------->
        <section id="references" class="mt-16 scroll-mt-24">
          <h2 class="text-2xl font-semibold">References</h2>
          <p class="mt-2 mb-8 max-w-[70ch] text-muted">
            Original sources first: arXiv, official docs, university courses and lab blogs. Every link was checked on {formatDate(d.updated)}.
          </p>
          <References refs={d.references} />
        </section>

        <!-- Prev / next -------------------------------------------------------->
        <nav aria-label="More roadmaps" class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
          {
            prev ? (
              <a href={`/roadmaps/${prev.id}/`} class="pane pane-hover p-5">
                <span class="text-xs text-muted">← Previous track</span>
                <span class="mt-1 block font-medium text-ink">{prev.data.title}</span>
              </a>
            ) : <span />
          }
          {
            next && (
              <a href={`/roadmaps/${next.id}/`} class="pane pane-hover p-5 text-right">
                <span class="text-xs text-muted">Next track →</span>
                <span class="mt-1 block font-medium text-ink">{next.data.title}</span>
              </a>
            )
          }
        </nav>
      </div>

      <!-- On this page -------------------------------------------------------->
      <nav aria-label="On this page" class="hidden lg:block" data-toc-nav>
        <div class="sticky top-24">
          <p class="eyebrow mb-3 !text-[var(--accent)]">On this page</p>
          <ul class="grid gap-1.5 border-l border-line text-sm">
            {
              toc.map((t) => (
                <li>
                  <a
                    href={t.href}
                    data-toc-sub={t.sub ? '' : undefined}
                    data-toc-parent={t.href === '#field-guide' ? '' : undefined}
                    class:list={[
                      'toc-link -ml-px block border-l-2 border-transparent py-0.5 text-muted hover:border-[var(--accent)] hover:text-ink',
                      t.sub ? 'pl-7 text-[0.8rem]' : 'pl-4',
                    ]}
                  >
                    {t.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>
  </article>

  <RoadmapScripts />
  <TocSpy />
</BaseLayout>
