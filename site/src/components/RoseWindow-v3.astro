---
/**
 * Hero art v3 — "Compiled Rose" (software engineering).
 * A rose window built from software:
 *   • outer ring  — rotating source code (with a Jesuit motto in the commit message)
 *   • git ring    — main branch with feature branches that fork and merge back
 *   • glass ring  — stained-glass mosaic carrying an 8-service architecture
 *   • spokes      — requests flowing between the services and you (the gateway)
 */
import RoseFrame from './RoseFrame.astro';
import { arc, circlePath, glassFills, glassStrokes, polar, rand, sector } from '../lib/geometry';

const ID = 'rw3';

// --- Code ring ---
const CODE_R = 224;
const code =
  'while (alive) { learn(); build(); test(); ship(); serve(others); }  ·  git commit -m "ad maiorem Dei gloriam"  ·  ';
const codeLength = +(2 * Math.PI * CODE_R * 0.985).toFixed(1);

// --- Git ring ---
const MAIN = 205;
const BR = 188;
const commits = Array.from({ length: 24 }, (_, i) => i * 15);
const branches = [
  { from: 15, to: 75, cls: 'stroke-emerald', dot: 'fill-emerald' },
  { from: 105, to: 150, cls: 'stroke-ruby', dot: 'fill-ruby' },
  { from: 195, to: 255, cls: 'stroke-lapis', dot: 'fill-lapis' },
  { from: 285, to: 330, cls: 'stroke-amethyst', dot: 'fill-amethyst' },
].map((b) => {
  const [x0, y0] = polar(MAIN, b.from);
  const [x1, y1] = polar(BR, b.from + 8);
  const [x2, y2] = polar(BR, b.to - 8);
  const [x3, y3] = polar(MAIN, b.to);
  const [c0x, c0y] = polar(MAIN, b.from + 6);
  const [c1x, c1y] = polar(MAIN, b.to - 6);
  const d = `M ${x0} ${y0} Q ${c0x} ${c0y} ${x1} ${y1} ${arc(BR, b.from + 8, b.to - 8).replace(/^M [^A]+/, '')} Q ${c1x} ${c1y} ${x3} ${y3}`;
  const dots = Array.from({ length: 3 }, (_, k) => polar(BR, b.from + 8 + ((b.to - b.from - 16) * (k + 0.5)) / 3));
  return { ...b, d, dots };
});
const merges = new Set(branches.map((b) => b.to));

// --- Stained-glass mosaic (polar cells) ---
const cells = Array.from({ length: 2 }, (_, band) =>
  Array.from({ length: 16 }, (_, i) => {
    const r1 = band === 0 ? 96 : 138;
    const r2 = band === 0 ? 138 : 176;
    const off = band * 11.25;
    return {
      d: sector(r1, r2, i * 22.5 + off, (i + 1) * 22.5 + off),
      cls: glassFills[(i * 2 + band) % glassFills.length],
      k: 0.35 + rand(i + band * 40) * 0.75,
    };
  }),
).flat();

// --- Architecture: services on the glass ---
const services = ['api', 'auth', 'db', 'cache', 'queue', 'ci/cd', 'tests', 'docs'].map((name, i) => {
  const a = i * 45;
  const [x, y] = polar(150, a);
  const [sx, sy] = polar(92, a);
  return { name, x, y, a, sx, sy, cls: glassStrokes[i % glassStrokes.length], w: Math.max(38, name.length * 8 + 16) };
});
---

<RoseFrame id={ID} caption={'<span class="text-emerald">$</span> git log --graph <span class="mx-1.5 text-line-strong">|</span> build → test → deploy'}>
  <!-- Rotating source-code ring -->
  <defs><path id={`${ID}-code`} d={circlePath(CODE_R)}></path></defs>
  <g class="rose-spin">
    <text class="fill-gold font-mono" font-size="11.5" letter-spacing="0.5">
      <textPath href={`#${ID}-code`} textLength={codeLength} lengthAdjust="spacing">{code}{code}</textPath>
    </text>
  </g>
  <circle r="214" class="fill-none stroke-line-strong" stroke-width="1"></circle>

  <!-- Git history ring -->
  <g class="rose-spin-rev">
    <circle r={MAIN} class="fill-none stroke-gold/70" stroke-width="2"></circle>
    {branches.map((b) => <path d={b.d} class:list={['fill-none', b.cls]} stroke-width="2" stroke-linecap="round" />)}
    {branches.flatMap((b) => b.dots.map(([x, y]) => <circle cx={x} cy={y} r="3.6" class:list={[b.dot, 'stroke-elev']} stroke-width="1.2" />))}
    {
      commits.map((a) => {
        const [x, y] = polar(MAIN, a);
        return merges.has(a) ? (
          <circle cx={x} cy={y} r="5.5" class="fill-elev stroke-gold" stroke-width="2.2" />
        ) : (
          <circle cx={x} cy={y} r="3.4" class="fill-gold" />
        );
      })
    }
  </g>

  <!-- Stained-glass mosaic -->
  {cells.map((c) => <path d={c.d} class:list={[c.cls, 'stroke-line-strong']} style={`fill-opacity: calc(var(--glass-opacity) * ${c.k.toFixed(2)})`} stroke-width="1.4" />)}
  <circle r="182" class="fill-none stroke-gold/50" stroke-width="1"></circle>

  <!-- Service mesh: bus + requests to the gateway (you) -->
  <circle r="104" class="fill-none stroke-gold/60" stroke-width="1.2" stroke-dasharray="3 5"></circle>
  {
    services.map((s, i) => (
      <g>
        <line x1={s.sx} y1={s.sy} x2={s.x} y2={s.y} class="stroke-gold/50" stroke-width="1.2" />
        <path d={`M ${s.x} ${s.y} L ${s.sx} ${s.sy}`} class:list={['signal fill-none', s.cls]} stroke-width="2.4" stroke-linecap="round" style={`animation-delay:${(i * 0.6).toFixed(1)}s; animation-duration: 3.2s`} />
      </g>
    ))
  }
  {
    services.map((s) => (
      <g transform={`translate(${s.x} ${s.y})`}>
        <rect x={-s.w / 2} y="-13" width={s.w} height="26" rx="7" class:list={['fill-elev', s.cls]} stroke-width="1.6" />
        <text text-anchor="middle" dy="4" class="fill-ink font-mono" font-size="11" font-weight="600">{s.name}</text>
      </g>
    ))
  }
</RoseFrame>
