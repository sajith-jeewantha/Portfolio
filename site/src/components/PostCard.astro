---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../lib/content';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: H = 'h3' } = Astro.props;
const { title, description, pubDate, tags, cover, coverAlt, draft } = post.data;
---

<article class="pane pane-hover group relative flex h-full flex-col overflow-hidden">
  {
    cover && (
      <Image src={cover} alt={coverAlt ?? ''} width={720} class="aspect-[16/9] w-full border-b border-line object-cover" />
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)}</span>
      {draft && <span class="chip border-ruby/40 bg-ruby-soft py-0 text-ruby">Draft</span>}
    </p>
    <H class="mt-3 font-display text-2xl leading-tight font-semibold">
      <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 group-hover:text-lapis">{title}</a>
    </H>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{description}</p>
    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tags">
          {tags.map((t) => (
            <li class="font-mono text-[11px] text-gold">#{t}</li>
          ))}
        </ul>
      )
    }
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-lapis" aria-hidden="true">
      Read article <Icon name="arrow-right" class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</article>
