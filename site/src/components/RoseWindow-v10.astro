---
/**
 * Hero art v10 — "Triptych" (static).
 * Three gothic lancets like an altarpiece:
 *   left   — Software: glass panes carrying lines of code
 *   centre — You: portrait in the oculus, cross finial, diamond-quarry glass
 *   right  — Intelligence: a neural network cut into stained glass
 */
import Avatar from './Avatar.astro';
import { glassFills, rand } from '../lib/geometry';

const ID = 'rw10';
const W = 600;
const H = 540;
const SILL = 512;

type P = [number, number];
const archPath = (x1: number, x2: number, spring: number, apex: number) => {
  const m = (x1 + x2) / 2;
  const w = x2 - x1;
  return `M ${x1} ${SILL} V ${spring} C ${x1} ${spring - w * 0.42} ${m - w * 0.22} ${apex + 10} ${m} ${apex} C ${m + w * 0.22} ${apex + 10} ${x2} ${spring - w * 0.42} ${x2} ${spring} V ${SILL} Z`;
};

// Panels (outer frame → inner glass)
const left = { o: archPath(18, 186, 210, 92), i: archPath(30, 174, 214, 108), x1: 30, x2: 174 };
const centre = { o: archPath(206, 394, 170, 18), i: archPath(218, 382, 174, 34), x1: 218, x2: 382 };
const right = { o: archPath(414, 582, 210, 92), i: archPath(426, 570, 214, 108), x1: 426, x2: 570 };

// --- Left: code panes ---
const code = [
  'class Engineer {',
  '  faith: Faith;',
  '  learn() {}',
  '  build() {}',
  '  test() {}',
  '  ship() {}',
  '  serve(others)',
  '}',
  '// AMDG',
];
const rowH = (SILL - 150) / code.length;
const codePanes = code.map((line, i) => ({
  y: 150 + i * rowH,
  line,
  cls: glassFills[(i * 2) % glassFills.length],
  k: (0.45 + rand(i + 3) * 0.6).toFixed(2),
}));

// --- Centre: diamond quarries below the oculus ---
const OC: P = [300, 150];
const OC_R = 66;
const quarries: { pts: string; cls: string; k: string }[] = [];
const QW = 28;
const QH = 40;
for (let r = 0; r < 12; r++)
  for (let c = -4; c <= 4; c++) {
    const cx = 300 + c * QW + (r % 2 ? QW / 2 : 0);
    const cy = 250 + r * (QH / 2);
    quarries.push({
      pts: `${cx},${cy - QH / 2} ${cx + QW / 2},${cy} ${cx},${cy + QH / 2} ${cx - QW / 2},${cy}`,
      cls: (r + c) % 4 === 0 ? 'fill-gold' : glassFills[(r * 3 + c + 10) % glassFills.length],
      k: (0.3 + rand(r * 20 + c + 99) * 0.6).toFixed(2),
    });
  }

// --- Right: neural network glass ---
const layerY = [470, 400, 330, 260, 190];
const layerN = [4, 5, 5, 4, 2];
const layers: P[][] = layerY.map((y, li) =>
  Array.from({ length: layerN[li] }, (_, i) => [right.x1 + 20 + ((right.x2 - right.x1 - 40) * (i + 0.5)) / layerN[li], y] as P),
);
const edges: [P, P][] = [];
for (let l = 0; l < layers.length - 1; l++) for (const a of layers[l]) for (const b of layers[l + 1]) edges.push([a, b]);
const nnPanes = layers.slice(0, -1).flatMap((ly, li) =>
  ly.slice(0, -1).map((a, i) => {
    const b = ly[i + 1];
    const up = layers[li + 1][Math.min(i, layers[li + 1].length - 1)];
    return { pts: [a, b, up].map((p) => p.join(',')).join(' '), cls: glassFills[(li * 2 + i) % glassFills.length], k: (0.5 + rand(li * 9 + i) * 0.6).toFixed(2) };
  }),
);
---

<figure class="mx-auto w-full max-w-[22rem] sm:max-w-[30rem] lg:max-w-[34rem]">
  <div class="relative aspect-[600/560] w-full">
    <svg viewBox={`0 -14 ${W} 560`} class="absolute inset-0 size-full overflow-visible" aria-hidden="true">
      <defs>
        <clipPath id={`${ID}-l`}><path d={left.i}></path></clipPath>
        <clipPath id={`${ID}-c`}><path d={centre.i}></path></clipPath>
        <clipPath id={`${ID}-r`}><path d={right.i}></path></clipPath>
        <radialGradient id={`${ID}-halo`} cx="0.5" cy="0.35" r="0.65">
          <stop offset="0" stop-color="var(--gold)" stop-opacity="0.22"></stop>
          <stop offset="1" stop-color="var(--gold)" stop-opacity="0"></stop>
        </radialGradient>
      </defs>

      <ellipse cx="300" cy="260" rx="320" ry="290" fill={`url(#${ID}-halo)`}></ellipse>

      <!-- Cross finial -->
      <path d="M300 -12 V12 M290 -3 H310" class="stroke-gold" stroke-width="3.2" stroke-linecap="round"></path>

      <!-- Frames -->
      {[left, centre, right].map((p) => <path d={p.o} class="fill-elev stroke-line-strong" stroke-width="1.5" />)}

      <!-- LEFT: code -->
      <g clip-path={`url(#${ID}-l)`}>
        <rect x="0" y="0" width={W} height={H} class="fill-lapis" style="fill-opacity: calc(var(--glass-opacity) * 0.6)"></rect>
        {
          codePanes.map((p) => (
            <>
              <rect x={left.x1} y={p.y} width={left.x2 - left.x1} height={rowH} class:list={[p.cls, 'stroke-line-strong']} style={`fill-opacity: calc(var(--glass-opacity) * ${p.k})`} stroke-width="1.4" />
              <text x={left.x1 + 10} y={p.y + rowH / 2 + 4} class="fill-ink font-mono" font-size="11" font-weight="500" xml:space="preserve">{p.line}</text>
            </>
          ))
        }
        <!-- tracery above the code: small trefoil -->
        {[[102, 128, 14], [84, 152, 9], [120, 152, 9]].map(([x, y, r]) => <circle cx={x} cy={y} r={r} class="fill-gold stroke-line-strong" style="fill-opacity: calc(var(--glass-opacity) * 0.9)" stroke-width="1.2" />)}
        <text x="102" y="132" text-anchor="middle" class="fill-ink font-mono" font-size="11" font-weight="700">{'</>'}</text>
      </g>

      <!-- CENTRE: you -->
      <g clip-path={`url(#${ID}-c)`}>
        <rect x="0" y="0" width={W} height={H} class="fill-amethyst" style="fill-opacity: calc(var(--glass-opacity) * 0.5)"></rect>
        {quarries.map((q) => <polygon points={q.pts} class:list={[q.cls, 'stroke-line-strong']} style={`fill-opacity: calc(var(--glass-opacity) * ${q.k})`} stroke-width="1.2" />)}
        {Array.from({ length: 12 }, (_, i) => {
          const a = (i * Math.PI) / 6;
          return <line x1={OC[0] + Math.sin(a) * (OC_R + 8)} y1={OC[1] - Math.cos(a) * (OC_R + 8)} x2={OC[0] + Math.sin(a) * (OC_R + 30)} y2={OC[1] - Math.cos(a) * (OC_R + 30)} class="stroke-gold/70" stroke-width="1.4" />;
        })}
        <circle cx={OC[0]} cy={OC[1]} r={OC_R + 30} class="fill-gold stroke-gold/70" style="fill-opacity: calc(var(--glass-opacity) * 0.35)" stroke-width="1.4"></circle>
      </g>
      <circle cx={OC[0]} cy={OC[1]} r={OC_R + 8} class="fill-elev stroke-gold" stroke-width="2.6"></circle>

      <!-- RIGHT: neural network -->
      <g clip-path={`url(#${ID}-r)`}>
        <rect x="0" y="0" width={W} height={H} class="fill-emerald" style="fill-opacity: calc(var(--glass-opacity) * 0.45)"></rect>
        {nnPanes.map((p) => <polygon points={p.pts} class:list={[p.cls, 'stroke-line-strong']} style={`fill-opacity: calc(var(--glass-opacity) * ${p.k})`} stroke-width="1.4" />)}
        <g class="stroke-gold" stroke-opacity="0.45" stroke-width="0.9">
          {edges.map(([a, b]) => <line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} />)}
        </g>
        {layers.map((ly, li) => ly.map(([x, y]) => <circle cx={x} cy={y} r={li === 0 ? 6 : 5} class={li === 0 ? 'fill-emerald stroke-elev' : li === layers.length - 1 ? 'fill-gold stroke-elev' : 'fill-elev stroke-gold'} stroke-width="1.8" />))}
        {[[498, 128, 14], [480, 152, 9], [516, 152, 9]].map(([x, y, r]) => <circle cx={x} cy={y} r={r} class="fill-gold stroke-line-strong" style="fill-opacity: calc(var(--glass-opacity) * 0.9)" stroke-width="1.2" />)}
        <text x="498" y="133" text-anchor="middle" class="fill-ink font-display" font-size="15" font-style="italic" font-weight="700">∇</text>
      </g>

      <!-- Mouldings, mullions & sill -->
      {[left, centre, right].map((p) => <path d={p.i} class="fill-none stroke-gold/70" stroke-width="1.6" />)}
      <rect x="8" y={SILL} width="584" height="12" rx="3" class="fill-elev stroke-line-strong" stroke-width="1.2"></rect>
      <text x="102" y={SILL + 28} text-anchor="middle" class="fill-muted font-mono" font-size="11" letter-spacing="2">CODE</text>
      <text x="300" y={SILL + 28} text-anchor="middle" class="fill-gold font-mono" font-size="11" letter-spacing="2">FAITH</text>
      <text x="498" y={SILL + 28} text-anchor="middle" class="fill-muted font-mono" font-size="11" letter-spacing="2">MIND</text>
    </svg>

    <Avatar
      class="absolute -translate-x-1/2 -translate-y-1/2 rounded-full"
      style={`left:${(OC[0] / W) * 100}%; top:${(((OC[1] + 14) / 560) * 100).toFixed(2)}%; width:${((OC_R * 2) / W) * 100}%; aspect-ratio:1;`}
    />
  </div>
</figure>
