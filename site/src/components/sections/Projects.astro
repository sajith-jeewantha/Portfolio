---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { getProjects } from '../../lib/content';

const { projects, categories } = await getProjects();

const linkIcon: Record<string, string> = {
  github: 'ri:github-fill',
  website: 'globe',
  post: 'file-text',
  docker: 'container',
  video: 'ri:youtube-fill',
  other: 'link',
};
const statusLabel = { completed: 'Completed', 'in-progress': 'In progress', published: 'Published' } as const;
const tones = [
  'bg-lapis-soft text-lapis',
  'bg-ruby-soft text-ruby',
  'bg-emerald-soft text-emerald',
  'bg-amethyst-soft text-amethyst',
  'bg-gold-soft text-gold',
];
---

<section id="projects" class="container-x py-20" aria-labelledby="projects-title">
  <SectionHeading
    id="projects-title"
    index="04"
    eyebrow="Projects"
    title="Things I've"
    accent="built."
    description="Selected work across backend systems, APIs, and AI & machine learning."
  />

  {
    categories.length > 1 && (
      <div class="mb-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects" data-reveal>
        <button type="button" data-filter="all" aria-pressed="true" class="filter-btn chip cursor-pointer px-4 py-2 text-sm">
          All
        </button>
        {categories.map((c) => (
          <button type="button" data-filter={c.id} aria-pressed="false" class="filter-btn chip cursor-pointer px-4 py-2 text-sm">
            <Icon name={c.data.icon} /> {c.data.label}
          </button>
        ))}
      </div>
    )
  }

  <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="project-list">
    {
      projects.map((p, i) => (
        <li data-categories={p.data.categories.join(' ')} data-reveal style={`--delay:${(i % 3) * 90}ms`}>
          <article class="pane pane-hover group flex h-full flex-col overflow-hidden">
            <div class="relative flex items-end justify-between gap-3 border-b border-line px-6 pt-6 pb-5">
              <span class:list={['arch grid size-14 place-items-center pt-1.5', tones[i % tones.length]]}>
                <Icon name={p.data.icon} size="26" />
              </span>
              <div class="flex flex-wrap justify-end gap-1.5">
                <span class:list={['chip', p.data.status === 'in-progress' ? 'border-emerald/40 bg-emerald-soft text-emerald' : 'border-gold/40 bg-gold-soft text-gold']}>
                  <Icon name={p.data.status === 'in-progress' ? 'loader' : 'check'} />
                  {statusLabel[p.data.status]}
                </span>
                <span class="chip font-mono">{p.data.year}</span>
              </div>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-2xl font-semibold">{p.data.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{p.data.description}</p>

              {p.data.features.length > 0 && (
                <ul class="mt-5 grid gap-2 text-sm" aria-label="Key features">
                  {p.data.features.map((f) => (
                    <li class="flex items-start gap-2">
                      <Icon name="sparkle" class="mt-1 text-gold" />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}

              {p.data.tech.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
                  {p.data.tech.map((t) => (
                    <li class="rounded-md border border-line bg-elev px-2 py-0.5 font-mono text-[11px] text-text">{t}</li>
                  ))}
                </ul>
              )}

              <div class="mt-auto flex flex-wrap gap-2 pt-6">
                {p.data.links.map((l) => (
                  <a
                    href={l.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-line-strong px-3 py-1.5 text-sm font-medium text-ink transition-colors hover:border-gold hover:text-lapis"
                  >
                    <Icon name={linkIcon[l.type]} /> {l.label}
                    <span class="sr-only">— {p.data.title}</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ul>
  <p id="project-empty" class="hidden py-10 text-center text-muted">No projects in this category yet.</p>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('#project-list > li');
  const empty = document.getElementById('project-empty');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((li) => {
        const match = f === 'all' || li.dataset.categories!.split(' ').includes(f);
        li.hidden = !match;
        if (match) shown++;
      });
      empty?.classList.toggle('hidden', shown > 0);
    }),
  );
</script>

<style>
  .filter-btn[aria-pressed='true'] {
    background: var(--lapis);
    border-color: var(--lapis);
    color: var(--on-lapis);
  }
</style>
