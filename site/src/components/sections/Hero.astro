---
import Icon from '../Icon.astro';
import SocialLink from '../SocialLink.astro';
import Medallion from '../Medallion.astro';
import { getHeroArt } from '../hero-art';
import { profile, site } from '../../lib/content';

const HeroArt = getHeroArt(site.heroArt).Art;
---

<section class="container-x grid items-center gap-14 pt-12 pb-20 lg:grid-cols-[1.1fr_1fr] lg:pt-20 lg:pb-28" aria-labelledby="hero-title">
  <div class="order-2 lg:order-1">
    <p class="chip w-fit border-gold/40 py-1.5 font-mono tracking-wide" data-reveal>
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald opacity-60 motion-reduce:hidden"></span>
        <span class="relative inline-flex size-2 rounded-full bg-emerald"></span>
      </span>
      {profile.current.role} @ {profile.current.company} · {profile.location}
    </p>

    <h1 id="hero-title" class="mt-7 font-display text-5xl leading-[0.95] font-semibold tracking-tight sm:text-6xl lg:text-7xl" data-reveal style="--delay:80ms">
      {profile.name.split(' ')[0]}<br />
      <span class="glass-text italic">{profile.name.split(' ').slice(1).join(' ')}</span>
    </h1>

    <p class="mt-6 font-mono text-sm text-lapis" data-reveal style="--delay:140ms">
      <span class="text-gold">&gt;</span> {profile.headline.toLowerCase().replaceAll(' ', '_')}<span class="ml-0.5 inline-block h-4 w-2 translate-y-0.5 animate-pulse bg-lapis motion-reduce:animate-none"></span>
    </p>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-text" data-reveal style="--delay:200ms">{profile.intro}</p>

    <blockquote class="mt-6 max-w-xl border-l-2 border-gold/70 pl-5 font-display text-xl leading-snug text-ink italic" data-reveal style="--delay:260ms">
      {profile.mission}
    </blockquote>

    <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--delay:320ms">
      <a href={profile.contact.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
        {profile.contact.label}
        <Icon name="arrow-up-right" />
      </a>
      <a href="#projects" class="btn-ghost">View projects <Icon name="arrow-right" /></a>
      <a href="/blog/" class="btn-ghost">Read the blog <Icon name="book-open" /></a>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5" data-reveal style="--delay:380ms">
      <div>
        <p class="mb-2.5 text-xs font-medium tracking-wide text-muted uppercase">Connect</p>
        <ul class="flex gap-2">
          {
            profile.socials.map((s) => (
              <li>
                <SocialLink {...s} class="backdrop-blur" />
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="mb-2.5 text-xs font-medium tracking-wide text-muted uppercase">Skill profiles</p>
        <ul class="flex gap-2">
          {
            profile.skillProfiles.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.name} data-tip={s.name} class="tip block transition-transform hover:-translate-y-0.5">
                  <Medallion name={s.logo} alt={s.name} class="size-10 rounded-xl p-1.5" px={28} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="order-1 lg:order-2" data-reveal style="--delay:120ms">
    <HeroArt />
  </div>
</section>
