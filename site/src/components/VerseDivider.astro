---
/** Gilded ornament with a short verse beneath it — used between sections. */
import Ornament from './Ornament.astro';
import { getVerse, VERSE_TRANSLATION } from '../lib/content';

interface Props {
  id: string;
  class?: string;
}
const { id, class: className = '' } = Astro.props;
const verse = await getVerse(id);
---

<figure class:list={['mx-auto max-w-3xl text-center', className]} data-reveal>
  <Ornament />
  <blockquote class="mt-6 font-display text-xl leading-snug text-ink italic sm:text-2xl">
    &ldquo;{verse.data.text}&rdquo;
  </blockquote>
  <figcaption class="mt-3 font-mono text-xs tracking-wide text-gold">
    — {verse.data.reference} <span class="text-muted">· {VERSE_TRANSLATION}</span>
  </figcaption>
</figure>
