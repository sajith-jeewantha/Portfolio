---
/**
 * Inline SVG icon rendered at build time — zero JavaScript, no icon font.
 *   <Icon name="sun" />            → Lucide (default set)
 *   <Icon name="ri:github-fill" /> → Remix Icon (brand logos)
 *   <Icon name="si:huggingface" /> → Simple Icons (brands Remix doesn't have; slug from simpleicons.org)
 */
import { getIconData, iconToSVG, iconToHTML, replaceIDs } from '@iconify/utils';
import lucide from '@iconify-json/lucide/icons.json';
import remix from '@iconify-json/ri/icons.json';
import type { IconifyIcon, IconifyJSON } from '@iconify/types';
import * as simpleIcons from 'simple-icons';

interface Props {
  name: string;
  class?: string;
  size?: number | string;
  label?: string;
}

const { name, class: className = '', size = '1em', label } = Astro.props;
const sets: Record<string, IconifyJSON> = { lucide: lucide as IconifyJSON, ri: remix as IconifyJSON };
const [prefix, iconName] = name.includes(':') ? name.split(':') : ['lucide', name];
/** Simple Icons ship one 24×24 path per brand; drawn in currentColor like the other sets. */
function simpleIcon(slug: string): IconifyIcon | null {
  const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}` as keyof typeof simpleIcons;
  const icon = simpleIcons[key] as { path: string } | undefined;
  return icon ? { body: `<path fill="currentColor" d="${icon.path}"/>`, width: 24, height: 24 } : null;
}

const data = prefix === 'si' ? simpleIcon(iconName) : sets[prefix] && getIconData(sets[prefix], iconName);
if (!data) throw new Error(`Icon "${name}" not found`);

const { attributes, body } = iconToSVG(data, { height: size });
const svg = iconToHTML(replaceIDs(body), {
  ...attributes,
  class: `inline-block shrink-0 ${className}`.trim(),
  ...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }),
});
---

<Fragment set:html={svg} />
