---
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';
import { profile, site } from '../lib/content';

const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/blog') && path.startsWith('/blog');
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/75 backdrop-blur-xl">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label={`${profile.name} — home`}>
      <Monogram />
      <span class="leading-tight">
        <span class="block font-display text-xl font-semibold text-ink">{profile.name}</span>
        <span class="block font-mono text-[10px] tracking-[0.18em] text-muted uppercase">{profile.role}</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-3.5 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-ink aria-[current=page]:text-lapis"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block"><ThemeToggle /></div>
      <button
        id="menu-btn"
        type="button"
        class="grid size-10 cursor-pointer place-items-center rounded-xl border border-line bg-surface text-ink lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <span class="menu-open"><Icon name="menu" size="20" /></span>
        <span class="menu-close hidden"><Icon name="x" size="20" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 backdrop-blur-xl lg:hidden">
    <nav aria-label="Mobile" class="container-x py-4">
      <ul class="grid gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between rounded-xl px-3 py-3 text-base font-medium text-ink hover:bg-surface"
              >
                {item.label}
                <Icon name="chevron-right" class="text-muted" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-4 flex items-center justify-between border-t border-line pt-4 sm:hidden">
        <span class="text-sm text-muted">Theme</span>
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.menu-open')?.classList.toggle('hidden', open);
    btn.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  };
  btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
